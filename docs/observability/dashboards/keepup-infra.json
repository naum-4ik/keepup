    {
      "id": 11,
      "type": "table",
      "title": "Slowest database calls (p95 over the range) \u00b7 $env",
      "description": "Each PostgREST read or RPC, by its short span name. Full URLs stay in the traces.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 65
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (span_name) (rate(traces_spanmetrics_latency{service=\"keepup\", span_kind=\"SPAN_KIND_CLIENT\", span_name=~\"fetch .*\", deployment_environment=~\"$env\"}[$__range]))))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "span_name": "Call",
              "Value": "p95"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "p95",
                "desc": true
              }
            ]
          }
        }
      ],
      "repeat": "env",
      "repeatDirection": "h",
      "maxPerRow": 2
    },
