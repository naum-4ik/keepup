{
  "__inputs": [
    {
      "name": "DS_PROM",
      "label": "Metrics (Prometheus / Mimir)",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Logs (Loki)",
      "type": "datasource",
      "pluginId": "loki"
    }
  ],
  "title": "Keepup \u00b7 Infra",
  "uid": "keepup-infra",
  "tags": [
    "keepup",
    "infra"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(traces_spanmetrics_calls_total{service=\"keepup\"}, deployment_environment)",
          "refId": "env"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{service=\"keepup\"}, deployment_environment)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys (staging)",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "{service_name=\"keepup-ci\"} | event_name=\"keepup.deployed\" | deploy_target=\"Production\" | deploy_state=\"success\"",
        "titleFormat": "Deploy",
        "textFormat": "{{git_sha}} {{deploy_url}}",
        "tagKeys": "deploy_target"
      },
      {
        "name": "Deploys (production)",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "{service_name=\"keepup-ci\"} | event_name=\"keepup.deployed\" | deploy_env=\"production\"",
        "titleFormat": "Production deploy ({{deploy_state}})",
        "textFormat": "{{git_sha}}",
        "tagKeys": "deploy_env"
      },
      {
        "name": "Merges",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "enable": false,
        "iconColor": "purple",
        "expr": "{service_name=\"keepup-ci\"} | event_name=\"keepup.merged\" | git_ref=\"develop\"",
        "titleFormat": "Merge #{{pr_number}}",
        "textFormat": "{{change_title}}",
        "tagKeys": "git_ref"
      },
      {
        "name": "Releases",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "enable": true,
        "iconColor": "green",
        "expr": "{service_name=\"keepup-ci\"} | event_name=\"keepup.released\"",
        "titleFormat": "Release {{release_version}}",
        "textFormat": "",
        "tagKeys": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now (RED: rate, errors, duration)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / min",
      "description": "Incoming requests per minute, all pages (server spans).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum by (deployment_environment) (rate(traces_spanmetrics_calls_total{service=\"keepup\", span_kind=\"SPAN_KIND_SERVER\", deployment_environment=~\"$env\"}[$__rate_interval])) * 60",
          "instant": false,
          "range": true,
          "legendFormat": "{{deployment_environment}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate",
      "description": "Share of requests whose trace is marked failed (logError sets it).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "100 * (sum by (deployment_environment) (rate(traces_spanmetrics_calls_total{service=\"keepup\", span_kind=\"SPAN_KIND_SERVER\", deployment_environment=~\"$env\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or sum by (deployment_environment) (rate(traces_spanmetrics_calls_total{service=\"keepup\", span_kind=\"SPAN_KIND_SERVER\", deployment_environment=~\"$env\"}[$__rate_interval])) * 0) / sum by (deployment_environment) (rate(traces_spanmetrics_calls_total{service=\"keepup\", span_kind=\"SPAN_KIND_SERVER\", deployment_environment=~\"$env\"}[$__rate_interval]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{deployment_environment}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 response time",
      "description": "95% of requests are faster than this. With little traffic most requests are cold starts; targets come with the SLOs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "histogram_quantile(0.95, sum by (deployment_environment) (rate(traces_spanmetrics_latency{service=\"keepup\", span_kind=\"SPAN_KIND_SERVER\", deployment_environment=~\"$env\"}[$__rate_interval])))",
          "instant": false,
          "range": true,
          "legendFormat": "{{deployment_environment}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Server errors (in range)",
      "description": "keepup.error events in the selected time range (Loki, one instant count; a rolling count summed over the range counted each error ~150 times).",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (deployment_environment_name) (count_over_time({service_name=\"keepup\", deployment_environment_name=~\"$env\"} | event_name=\"keepup.error\" [$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{deployment_environment_name}}",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0",
          "displayName": "${__field.labels.deployment_environment_name}"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Database server (Supabase Postgres)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "stat",
      "title": "DB CPU",
      "description": "Busy time \u00f7 total time on the database machine (all cores): always 0\u2013100%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "label_replace(100 * sum by (job) (rate(node_cpu_seconds_total{mode!=\"idle\", job=~\".*supabase_$env\"}[$__rate_interval])) / sum by (job) (rate(node_cpu_seconds_total{job=~\".*supabase_$env\"}[$__rate_interval])), \"env\", \"$1\", \"job\", \".*supabase_(.*)\")",
          "legendFormat": "{{env}}",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "DB memory used",
      "description": "RAM in use on the database machine; Postgres keeps data in memory on purpose, so steady 70-80% is normal.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "label_replace(100 * (1 - sum by (job) (node_memory_MemAvailable_bytes{job=~\".*supabase_$env\"}) / sum by (job) (node_memory_MemTotal_bytes{job=~\".*supabase_$env\"})), \"env\", \"$1\", \"job\", \".*supabase_(.*)\")",
          "legendFormat": "{{env}}",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Data disk used",
      "description": "The /data disk, where Postgres keeps the database (the system disk / is Supabase's).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "label_replace(100 * max by (job) (1 - node_filesystem_avail_bytes{mountpoint=\"/data\", job=~\".*supabase_$env\"} / node_filesystem_size_bytes{mountpoint=\"/data\", job=~\".*supabase_$env\"}), \"env\", \"$1\", \"job\", \".*supabase_(.*)\")",
          "legendFormat": "{{env}}",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "type": "stat",
      "title": "DB size (free tier 500 MB)",
      "description": "Database size; Supabase's free plan allows 500 MB.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "label_replace(max by (job) (pg_database_size_mb{job=~\".*supabase_$env\"}), \"env\", \"$1\", \"job\", \".*supabase_(.*)\")",
          "legendFormat": "{{env}}",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 400
              },
              {
                "color": "red",
                "value": 475
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Connections",
      "description": "Open sessions to Postgres.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "label_replace(sum by (job) (pg_stat_database_num_backends{job=~\".*supabase_$env\"}), \"env\", \"$1\", \"job\", \".*supabase_(.*)\")",
          "legendFormat": "{{env}}",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 40
              },
              {
                "color": "red",
                "value": 55
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Cache hit",
      "description": "Reads served from memory, not disk. Healthy is 99%+.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "label_replace(100 * sum by (job) (rate(pg_stat_database_blks_hit_total{job=~\".*supabase_$env\"}[$__rate_interval])) / (sum by (job) (rate(pg_stat_database_blks_hit_total{job=~\".*supabase_$env\"}[$__rate_interval])) + sum by (job) (rate(pg_stat_database_blks_read_total{job=~\".*supabase_$env\"}[$__rate_interval]))), \"env\", \"$1\", \"job\", \".*supabase_(.*)\")",
          "legendFormat": "{{env}}",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "DB CPU and memory \u00b7 $env",
      "description": "The database machine over time.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "repeat": "env",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "100 * sum by (job) (rate(node_cpu_seconds_total{mode!=\"idle\", job=~\".*supabase_$env\"}[$__rate_interval])) / sum by (job) (rate(node_cpu_seconds_total{job=~\".*supabase_$env\"}[$__rate_interval]))",
          "legendFormat": "CPU %",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "100 * (1 - sum by (job) (node_memory_MemAvailable_bytes{job=~\".*supabase_$env\"}) / sum by (job) (node_memory_MemTotal_bytes{job=~\".*supabase_$env\"}))",
          "legendFormat": "Memory %",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "DB connections \u00b7 $env",
      "description": "Open sessions to Postgres over time.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "repeat": "env",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum by (job) (pg_stat_database_num_backends{job=~\".*supabase_$env\"})",
          "legendFormat": "connections",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 24,
      "type": "row",
      "title": "Limits (used vs maximum)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": []
    },
    {
      "id": 25,
